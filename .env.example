[TEMPLATE]
# Copie para .env.local e preencha só os provedores que for usar.
# As chaves ficam SOMENTE no servidor (app/api/*) e nunca vão ao navegador.
# Os quatro provedores abaixo são compatíveis com a integração. A ORDEM é a do FALLBACK:
# se o provedor/modelo escolhido falhar, o servidor tenta o próximo que tiver chave.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Consulta de placa (wdapi2) — token do contrato; NUNCA commitar o valor real.
# Sem esta variável, a rota /api/placa devolve 500 { error: 'nokey' }.
PLACA_API_TOKEN=

# OpenRouter (modelos :free) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Cohere (chave trial gratuita) — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
