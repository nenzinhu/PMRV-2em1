# Copie para .env.local e preencha só os provedores que for usar.
# As chaves ficam SOMENTE no servidor (app/api/ai) e nunca vão ao navegador.
# Todos abaixo têm plano gratuito e API compatível com OpenAI.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (modelos :free) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral (plano Experiment gratuito) — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Cloudflare Workers AI (10 mil neurons/dia grátis) — https://dash.cloudflare.com/profile/api-tokens
# Token com permissão "Workers AI"; o Account ID fica na página inicial do painel.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cohere (chave trial gratuita) — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Hugging Face Inference Providers (créditos mensais grátis) — https://huggingface.co/settings/tokens
HF_TOKEN=

# NVIDIA NIM (build.nvidia.com) — https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# Z.ai / GLM Flash — https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# SambaNova Cloud — https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
