# Copie para .env.local e preencha só os provedores que for usar.
# As chaves ficam SOMENTE no servidor (app/api/ai) e nunca vão ao navegador.
# Todos abaixo são compatíveis com OpenAI. A ORDEM abaixo é a ordem do FALLBACK:
# se o provedor/modelo escolhido falhar, o servidor tenta o próximo que tiver chave.

# Groq — https://console.groq.com/keys  (também aceita o nome GRoapi)
GROQ_API_KEY=

# OpenRouter (modelos :free) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral (plano Experiment gratuito) — https://console.mistral.ai/api-keys — recomendado para a aba Danos (lê fotos)
MISTRAL_API_KEY=

# Cloudflare Workers AI (10 mil neurons/dia grátis) — https://dash.cloudflare.com/profile/api-tokens
# Token com permissão "Workers AI"; o Account ID fica na página inicial do painel.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cohere (chave trial gratuita) — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Hugging Face Inference Providers (créditos mensais grátis) — https://huggingface.co/settings/tokens
# (também aceita HUGGINGFACE_API_KEY)
HF_TOKEN=

# NVIDIA NIM (build.nvidia.com) — https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# Z.ai / GLM Flash — https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# SambaNova Cloud — https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# AIHubMix (modelos *-free) — https://aihubmix.com/token
AIHUBMIX_API_KEY=

# AnyAPI (modelos :free) — https://dash.anyapi.ai  (também aceita ANYAPI-KEY)
ANYAPI_API_KEY=

# OrcaRouter (alias orcarouter/free) — https://www.orcarouter.ai
ORCAROUTER_API_KEY=

# ModelScope (2.000 req/dia grátis) — https://modelscope.cn/my/myaccesstoken  (também aceita MODEL_SCOPE_API)
MODELSCOPE_API_KEY=

# Nous Portal (catálogo gratuito rotativo) — https://portal.nousresearch.com
NOUS_API_KEY=

# Together (usa créditos da conta; sem plano free) — https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
